--- /dev/null
+++ b/verl/models/transformers/gpt_oss_case2/__init__.py
@@ -0,0 +1,375 @@
+"""GPT-OSS BF16/TP1 forward matching the Case 2 vLLM rollout."""
+
+from types import MethodType
+
+import torch
+import torch.nn.functional as F
+from transformers.modeling_outputs import MoeModelOutputWithPast
+from vllm import _custom_ops as ops
+from vllm.config import CompilationConfig, VllmConfig, set_current_vllm_config
+from vllm.model_executor.determinism.batch_invariant import linear_batch_invariant, rms_norm_batch_invariant
+from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+from vllm.model_executor.layers.fused_moe.config import (
+    FusedMoEConfig,
+    FusedMoEParallelConfig,
+    RoutingMethodType,
+    biased_moe_quant_config,
+)
+from vllm.model_executor.layers.fused_moe.experts.triton_moe import TritonExperts
+from vllm.model_executor.layers.fused_moe.router.fused_topk_router import fused_topk
+from vllm.model_executor.layers.rotary_embedding import get_rope
+from vllm.v1.attention.ops.triton_unified_attention import unified_attention
+
+
+class Linear(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, weight, bias):
+        ctx.save_for_backward(x, weight)
+        ctx.has_bias = bias is not None
+        return linear_batch_invariant(x, weight, bias)
+
+    @staticmethod
+    def backward(ctx, grad):
+        x, w = ctx.saved_tensors
+        g = grad.reshape(-1, grad.shape[-1]).float()
+        inp = x.reshape(-1, x.shape[-1]).float()
+        dx = (g @ w.float()).reshape_as(x).to(x.dtype) if ctx.needs_input_grad[0] else None
+        dw = (g.T @ inp).to(w.dtype) if ctx.needs_input_grad[1] else None
+        db = g.sum(dim=0).to(w.dtype) if ctx.has_bias and ctx.needs_input_grad[2] else None
+        return dx, dw, db
+
+
+class SelectedLogprob(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, logits, labels):
+        from vllm.v1.worker.gpu.sample.logprob import compute_token_logprobs
+
+        ctx.save_for_backward(logits, labels)
+        return compute_token_logprobs(logits.contiguous(), labels.unsqueeze(-1)).squeeze(-1)
+
+    @staticmethod
+    def backward(ctx, upstream):
+        logits, labels = ctx.saved_tensors
+        gradient = torch.empty_like(logits)
+        with torch.autocast("cuda", enabled=False):
+            for lo in range(0, logits.shape[0], 128):
+                hi = lo + 128
+                dy = upstream[lo:hi].float().unsqueeze(-1)
+                grad = logits[lo:hi].float().softmax(dim=-1).mul_(-dy)
+                grad.scatter_add_(1, labels[lo:hi].unsqueeze(-1), dy)
+                gradient[lo:hi].copy_(grad)
+        return gradient, None
+
+
+def selected_logprobs(
+    logits, labels, *, temperature=None, inplace_backward=True, batch_invariant=True, vocab_size=None
+):
+    if temperature is not None:
+        raise ValueError("GPT-OSS Case 2 validated sampling temperature=1")
+    if vocab_size is not None and vocab_size < logits.shape[-1]:
+        # Match the online vLLM OOV mask while keeping the logprob kernel's reduction width.
+        logits = logits.clone(memory_format=torch.contiguous_format)
+        logits[..., vocab_size:] = float("-inf")
+    return SelectedLogprob.apply(logits, labels.long())
+
+
+def linear_forward(self, x):
+    return Linear.apply(x, self.weight, self.bias)
+
+
+def norm_vjp(x, weight, grad, eps):
+    inv = torch.rsqrt(x.square().mean(dim=-1, keepdim=True) + eps)
+    normalized = x * inv
+    dw = (grad * normalized).sum(dim=0)
+    gw = grad * weight.float()
+    dx = inv * (gw - normalized * (normalized * gw).mean(dim=-1, keepdim=True))
+    return dx, dw
+
+
+class Norm(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, weight, eps):
+        ctx.save_for_backward(x, weight)
+        ctx.eps = eps
+        return rms_norm_batch_invariant(x, weight, eps)
+
+    @staticmethod
+    def backward(ctx, grad):
+        x, w = ctx.saved_tensors
+        dx, dw = norm_vjp(x.float(), w, grad.float(), ctx.eps)
+        return dx.to(x.dtype), dw.to(w.dtype), None
+
+
+class AddNorm(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, residual, weight, eps):
+        x_out = x.clone()
+        residual_out = residual.clone()
+        output, carried = rms_norm_batch_invariant(x_out, weight, eps, residual=residual_out)
+        ctx.save_for_backward(carried, weight)
+        ctx.eps = eps
+        return output, carried
+
+    @staticmethod
+    def backward(ctx, grad, residual_grad):
+        carried, weight = ctx.saved_tensors
+        dx, dw = norm_vjp(carried.float(), weight, grad.float(), ctx.eps)
+        if residual_grad is not None:
+            dx = dx + residual_grad.float()
+        dx = dx.to(carried.dtype)
+        return dx, dx, dw.to(weight.dtype), None
+
+
+def make_rope_cache(config):
+    # Build YaRN coefficients on CUDA in FP32, then explicitly match the
+    # eager rotary kernel's BF16 cache before any FSDP forward input cast.
+    with set_current_vllm_config(VllmConfig(compilation_config=CompilationConfig(custom_ops=["none"]))), torch.device("cuda"):
+        rope = get_rope(config.head_dim, max_position=config.max_position_embeddings,
+                        dtype=torch.float32, rope_parameters=dict(config.rope_parameters),
+                        is_neox_style=True)
+    return rope.cos_sin_cache.detach().to(torch.bfloat16)
+
+
+class Rotate(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, q, k, positions, cache):
+        ctx.save_for_backward(cache.index_select(0, positions))
+        # The vLLM CUDA op updates Q/K in place. Preserve the projection views.
+        q, k = q.clone(memory_format=torch.contiguous_format), k.clone(memory_format=torch.contiguous_format)
+        ops.rotary_embedding(positions, q.flatten(1), k.flatten(1), q.shape[-1], cache, True)
+        return q, k
+
+    @staticmethod
+    def backward(ctx, grad_q, grad_k):
+        (rows,) = ctx.saved_tensors
+        cos, sin = rows.chunk(2, dim=-1)
+        c, s = cos[:, None].float(), sin[:, None].float()
+
+        def vjp(g):
+            ga, gb = g.float().chunk(2, dim=-1)
+            return torch.cat((ga * c + gb * s, gb * c - ga * s), dim=-1).to(g.dtype)
+
+        return vjp(grad_q), vjp(grad_k), None, None
+
+
+class PackedAttention:
+    def __init__(self, positions, cu_seqlens=None):
+        # With the recipe's one example per micro-batch this has one sequence.
+        # Packed replays can provide explicit offsets or use resets to position zero.
+        device = positions.device
+        if cu_seqlens is None:
+            starts = (positions == 0).nonzero().flatten()
+            cu_seqlens = torch.cat((starts, starts.new_tensor([positions.numel()])))
+        offsets = cu_seqlens.tolist()
+        if offsets[0] != 0 or offsets[-1] != positions.numel():
+            raise ValueError("GPT-OSS TIC expects zero-based unpadded sequences")
+        self.lengths = [b - a for a, b in zip(offsets[:-1], offsets[1:], strict=True)]
+        if min(self.lengths) < 1:
+            raise ValueError("GPT-OSS TIC received an empty packed sequence")
+
+        self.block_size = 16
+        pages = [(length + self.block_size - 1) // self.block_size for length in self.lengths]
+        rows, slots = [], []
+        block = 0
+        for length, count in zip(self.lengths, pages, strict=True):
+            rows.append(list(range(block, block + count)) + [0] * (max(pages) - count))
+            slots.extend(range(block * self.block_size, block * self.block_size + length))
+            block += count
+        self.blocks = block
+        self.cu_seqlens = cu_seqlens.to(device=device, dtype=torch.int32)
+        self.seq_lens = torch.tensor(self.lengths, device=device, dtype=torch.int32)
+        self.block_table = torch.tensor(rows, device=device, dtype=torch.int32)
+        self.slot_mapping = torch.tensor(slots, device=device, dtype=torch.long)
+
+    def forward(self, q, k, v, sinks, window):
+        hd = k.shape[-1]
+        nh = k.shape[-2]
+        cache = torch.zeros((self.blocks, self.block_size, nh, 2 * hd),
+                            dtype=k.dtype, device=k.device)
+        slots = cache.view(-1, nh, 2 * hd)
+        slots[..., :hd].index_copy_(0, self.slot_mapping, k)
+        slots[..., hd:].index_copy_(0, self.slot_mapping, v)
+        k_pages, v_pages = cache.split(hd, dim=-1)
+        out = torch.empty(q.shape, dtype=q.dtype, device=q.device)
+        unified_attention(
+            q=q, k=k_pages, v=v_pages, out=out,
+            cu_seqlens_q=self.cu_seqlens, max_seqlen_q=max(self.lengths),
+            seqused_k=self.seq_lens, max_seqlen_k=max(self.lengths),
+            softmax_scale=hd ** -0.5, causal=True,
+            window_size=(window - 1, 0) if window else (-1, -1),
+            block_table=self.block_table, softcap=0,
+            q_descale=None, k_descale=None, v_descale=None, sinks=sinks,
+        )
+        return out
+
+
+class Attention(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, q, k, v, sinks, metadata, window):
+        ctx.save_for_backward(q, k, v, sinks)
+        ctx.packed_attention, ctx.window = metadata, window
+        return metadata.forward(q, k, v, sinks, window)
+
+    @staticmethod
+    def backward(ctx, grad):
+        saved = ctx.saved_tensors
+        with torch.enable_grad(), torch.autocast("cuda", enabled=False):
+            q, k, v, sinks = [t.detach().float().requires_grad_() for t in saved]
+            groups = q.shape[-2] // k.shape[-2]
+            outputs = []
+            lengths = ctx.packed_attention.lengths
+            for qs, ks, vs in zip(q.split(lengths), k.split(lengths), v.split(lengths), strict=True):
+                keys = ks.repeat_interleave(groups, dim=1).transpose(0, 1)
+                values = vs.repeat_interleave(groups, dim=1).transpose(0, 1)
+                pos = torch.arange(len(qs), device=qs.device)
+                delta = pos[:, None] - pos[None, :]
+                illegal = delta < 0
+                if ctx.window:
+                    illegal = illegal | (delta >= ctx.window)
+                logits = (qs.transpose(0, 1) @ keys.transpose(1, 2)) * q.shape[-1] ** -0.5
+                logits = logits.masked_fill(illegal, -torch.inf)
+                sink_logits = sinks[:, None, None].expand(-1, qs.shape[0], 1)
+                probs = torch.cat((logits, sink_logits), dim=-1).softmax(dim=-1)[..., :-1]
+                outputs.append((probs @ values).transpose(0, 1))
+            grads = torch.autograd.grad(torch.cat(outputs), (q, k, v, sinks), grad.float())
+        return *(g.to(t.dtype) for g, t in zip(grads, saved, strict=True)), None, None
+
+
+class Route(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, logits, top_k):
+        scores, ids, _ = fused_topk(x, logits, top_k, renormalize=True)
+        ctx.save_for_backward(logits, ids)
+        return scores, ids
+
+    @staticmethod
+    def backward(ctx, grad, ignored):
+        logits, ids = ctx.saved_tensors
+        indices = ids.long()
+        p = logits.float().gather(1, indices).softmax(dim=-1)
+        top_grad = p * (grad - (grad * p).sum(dim=-1, keepdim=True))
+        result = torch.zeros_like(logits, dtype=torch.float32).scatter_(1, indices, top_grad)
+        return None, result.to(logits.dtype), None
+
+
+def expert_forward(x, w1, w2, b1, b2, scores, ids, cfg):
+    up = w1.transpose(1, 2).contiguous()
+    down = w2.transpose(1, 2).contiguous()
+    quant = biased_moe_quant_config(b1, b2)
+    experts = TritonExperts(cfg, quant)
+    m, k = x.shape
+    e, n, _ = up.shape
+    work1, work2, output = experts.workspace_shapes(
+        m, n, k, ids.shape[1], e, e, None, MoEActivation.SWIGLUOAI,
+    )
+    work1, work2, output = [x.new_empty(shape) for shape in (work1, work2, output)]
+    experts.apply(output, x, up, down, scores, ids, MoEActivation.SWIGLUOAI,
+                  e, None, None, None, work1, work2, None, False)
+    return output
+
+
+class Experts(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, w1, w2, b1, b2, scores, ids, cfg):
+        ctx.save_for_backward(x, w1, w2, b1, b2, scores, ids)
+        return expert_forward(x, w1, w2, b1, b2, scores, ids, cfg)
+
+    @staticmethod
+    def backward(ctx, grad):
+        x, w1, w2, b1, b2, scores, ids = ctx.saved_tensors
+        saved = x, w1, w2, b1, b2, scores
+        # Differentiate one active expert at a time to bound FP32 workspace.
+        dx = torch.zeros_like(x, dtype=torch.float32)
+        ds = torch.zeros_like(scores, dtype=torch.float32)
+        dw1, dw2, db1, db2 = [torch.zeros_like(t) for t in (w1, w2, b1, b2)]
+        with torch.enable_grad(), torch.autocast("cuda", enabled=False):
+            for expert in ids.unique().tolist():
+                row, slot = (ids == expert).nonzero(as_tuple=True)
+                values = (x[row], w1[expert], w2[expert], b1[expert], b2[expert], scores[row, slot])
+                xd, u, d, ub, db, route = [t.detach().float().requires_grad_() for t in values]
+                gate_up = xd @ u + ub
+                gate = gate_up[..., ::2].clamp(max=7.0)
+                up = gate_up[..., 1::2].clamp(-7.0, 7.0)
+                hidden = gate * torch.sigmoid(1.702 * gate) * (up + 1)
+                combined = (hidden @ d + db) * route[:, None]
+                grads = torch.autograd.grad(combined, (xd, u, d, ub, db, route), grad[row].float())
+                dx.index_add_(0, row, grads[0])
+                for target, value in zip((dw1, dw2, db1, db2), grads[1:5], strict=True):
+                    target[expert].copy_(value)
+                ds[row, slot] = grads[5]
+        return *(g.to(t.dtype) for g, t in zip((dx, dw1, dw2, db1, db2, ds), saved, strict=True)), None, None
+
+
+def decoder_forward(self, hidden, residual, positions, metadata):
+    # FSDP2 casts floating-point forward inputs to the parameter dtype.
+    # Keep the coefficient lookup on the inside of that input boundary.
+    n1 = self.input_layernorm
+    if residual is None:
+        residual = hidden
+        x = Norm.apply(hidden, n1.weight, n1.variance_epsilon)
+    else:
+        x, residual = AddNorm.apply(hidden, residual, n1.weight, n1.variance_epsilon)
+
+    attn = self.self_attn
+    projections = (attn.q_proj, attn.k_proj, attn.v_proj)
+    qkv = Linear.apply(x, torch.cat([p.weight for p in projections]),
+                       torch.cat([p.bias for p in projections]))
+    hd = attn.head_dim
+    q, k, v = [p.reshape(x.shape[0], -1, hd) for p in
+               qkv.split([p.weight.shape[0] for p in projections], dim=-1)]
+    q, k = Rotate.apply(q, k, positions, self._tic_rope_cache)
+    attended = Attention.apply(q, k, v, attn.sinks, metadata, attn.sliding_window or 0)
+    projected = Linear.apply(attended.flatten(1), attn.o_proj.weight, attn.o_proj.bias)
+    n2 = self.post_attention_layernorm
+    post, residual = AddNorm.apply(projected, residual, n2.weight, n2.variance_epsilon)
+
+    router, experts = self.mlp.router, self.mlp.experts
+    logits = Linear.apply(post, router.weight, router.bias)
+    scores, ids = Route.apply(post, logits, router.top_k)
+    cfg = self._tic_moe_cfg
+    cfg.device = post.device
+    out = Experts.apply(post, experts.gate_up_proj, experts.down_proj,
+                        experts.gate_up_proj_bias, experts.down_proj_bias, scores, ids, cfg)
+    return out, residual
+
+
+def backbone_forward(self, input_ids=None, attention_mask=None, position_ids=None,
+                     past_key_values=None, inputs_embeds=None, use_cache=None,
+                     cu_seqlens=None, **kwargs):
+    if past_key_values is not None or use_cache or attention_mask is not None:
+        raise ValueError("GPT-OSS TIC supports unpadded full-sequence scoring without a KV history")
+    if kwargs.get("output_router_logits", False):
+        raise ValueError("GPT-OSS TIC does not implement aux router loss")
+    hidden = self.embed_tokens(input_ids) if inputs_embeds is None else inputs_embeds
+    batch, length, width = hidden.shape
+    if position_ids is None:
+        position_ids = torch.arange(length, device=hidden.device).expand(batch, -1)
+    positions = position_ids.expand(batch, -1).reshape(-1).long()
+    metadata = PackedAttention(positions, cu_seqlens)
+    hidden = hidden.reshape(-1, width)
+    residual = None
+    for layer in self.layers:
+        hidden, residual = layer(hidden, residual, positions, metadata)
+    normalized, _ = AddNorm.apply(hidden, residual, self.norm.weight, self.norm.variance_epsilon)
+    return MoeModelOutputWithPast(last_hidden_state=normalized.reshape(batch, length, width))
+
+
+def install_gpt_oss_tic(module):
+    """Called only for the configured FSDP2 batch-invariant GPT-OSS instance."""
+    cfg = module.config
+    rope_cache = make_rope_cache(cfg)
+    module.model.forward = MethodType(backbone_forward, module.model)
+    module.lm_head.forward = MethodType(linear_forward, module.lm_head)
+    moe = FusedMoEConfig(
+        num_experts=cfg.num_local_experts, experts_per_token=cfg.num_experts_per_tok,
+        hidden_dim=cfg.hidden_size, intermediate_size=cfg.intermediate_size,
+        num_local_experts=cfg.num_local_experts, num_logical_experts=cfg.num_local_experts,
+        activation=MoEActivation.SWIGLUOAI, device="cuda",
+        routing_method=RoutingMethodType.Renormalize,
+        moe_parallel_config=FusedMoEParallelConfig.make_no_parallel(),
+        in_dtype=torch.bfloat16, has_bias=True,
+    )
+    for layer in module.model.layers:
+        layer._tic_rope_cache = rope_cache
+        layer._tic_moe_cfg = moe
+        layer.forward = MethodType(decoder_forward, layer)
